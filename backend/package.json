  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "h3-js": "^4.4.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
