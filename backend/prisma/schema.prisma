generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Community {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  owner         String
  community_link String?

  @@map("communities")
  cellCommunities CellCommunity[]
}

model CellCommunity {
  cellId      String
  communityId String   @db.Uuid

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([cellId, communityId])
  @@index([cellId])
  @@map("cell_communities")
}