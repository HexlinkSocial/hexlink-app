{
  "name": "lambdas",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "esbuild *.ts --bundle --minify --platform=node --target=node24 --outdir=dist --external:react --external:react-dom --external:react/jsx-runtime",
    "build:emails": "tsx scripts/buildEmails.ts",
    "watch:emails": "tsx scripts/buildEmails.ts --watch",
    "dev": "esbuild *.ts --bundle --minify --platform=node --target=node24 --outdir=dist --watch",
    "sam": "sam local start-api --template template.yml --port 4000 --host 0.0.0.0 --docker-network sam-app-network --env-vars sam-env.json --docker-volume-basedir \"/c/Hexlink/hexlink-app/lambdas\" --container-host host.docker.internal"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.1080.0",
    "aws-jwt-verify": "^5.2.1",
    "esbuild": "^0.28.1",
    "esbuild-sass-plugin": "^3.7.0",
    "pg": "^8.21.0",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
