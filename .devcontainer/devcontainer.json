{
  "name": "Hexlink Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  "remoteUser": "node",

  "forwardPorts": [5173, 4000, 5432],

  "postCreateCommand": "npm i && cd backend && npm i && npm run db:migrate && npm run db:seed && cd ../lambdas && sam build",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
