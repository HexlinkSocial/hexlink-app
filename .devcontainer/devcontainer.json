{
  "name": "Hexlink Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  "remoteUser": "node",

  "forwardPorts": [5173, 4000, 5432],

  "postCreateCommand": "npm install && cd backend && npm install && npx prisma migrate dev && npm run prisma:seed",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "prisma.prisma"
      ]
    }
  }
}
